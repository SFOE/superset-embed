{
  "name": "superset-embed",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "preview:ci": "npm run build-only && vite preview --host 0.0.0.0",
    "type-check": "vue-tsc --build",
    "test:unit": "vitest",
    "test:e2e": "start-server-and-test preview:ci http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.5.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.1.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.19",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "cypress": "^15.14.2",
    "eslint": "^10.4.1",
    "eslint-plugin-cypress": "^7.0.1",
    "eslint-plugin-vue": "^10.10.0",
    "fast-check": "^4.8.0",
    "jiti": "^2.7.0",
    "jsdom": "30.1.3",
    "npm-run-all2": "^9.0.1",
    "prettier": "3.9.9",
    "start-server-and-test": "^3.0.8",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "5.1.0",
    "vue-tsc": "^3.3.3"
  }
}

