# ============================================================
# .gitignore - superset-embed (Vue 3 / Vite / TypeScript)
# ============================================================

# === Dependencies & build output ===
node_modules/
dist/
dist-ssr/
coverage/
*.local

# === Test / tooling caches ===
.eslintcache
*.tsbuildinfo
.cypress/
cypress/screenshots/
cypress/videos/

# vue-tsc --build emits .js/.d.ts next to root config .ts files; not source
*.config.js
*.config.d.ts

# === Secrets & Credentials (NEVER commit these) ===
.env
.env.*
!.env.example
*.pem
*.key
credentials.*
secrets.*
*.token

# === IDE & OS ===
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
